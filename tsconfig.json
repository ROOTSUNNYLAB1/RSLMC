{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"],
    "paths": { "@/*": ["./src/*"], "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src", "frontend", "tests", "scripts"]
}
