# RSLMC environment configuration (copy to .env)
RSLMC_PORT=3000
RSLMC_HOST=0.0.0.0
# Data folder. Leave empty/absent to use the platform default:
#   Linux   /opt/rslmc
#   Windows %ProgramData%\RSLMC  (or %LOCALAPPDATA%\RSLMC without admin rights)
#   macOS   ~/Library/Application Support/RSLMC
# Set it only to override, e.g. RSLMC_DATA_DIR=D:\rslmc-data
RSLMC_DATA_DIR=
RSLMC_MODE=development
# Required in production: generate with: openssl rand -hex 32
RSLMC_SECRET=
RSLMC_TRUST_PROXY=false
# Optional: allow privileged cgroup enforcement through the helper (Linux only)
RSLMC_PRIV_HELPER=sudo
# The address you actually open the panel on, when a proxy/tunnel hides it
# (e.g. RSLMC_PUBLIC_URL=https://panel.example.com). Used by the same-origin check on writes.
RSLMC_PUBLIC_URL=
# Opt-in only: extra script origins for the Content-Security-Policy. Needed if your proxy injects a
# script into the HTML (Cloudflare Web Analytics). Prefer turning that injection off instead.
#   RSLMC_CSP_SCRIPT_SRC=https://static.cloudflareinsights.com
RSLMC_CSP_SCRIPT_SRC=

# ── Docker (optional) ─────────────────────────────────────────────────────────────────────────────
# The panel talks to the daemon through the `docker` CLI. On a typical VPS the panel runs as a normal
# user while the socket is root:docker 0660, so the daemon refuses it — even though `docker` works in
# your own root shell. Pick ONE of these:
#
#   1. give the panel's account the group and restart the panel (a running process keeps its old groups)
#        sudo usermod -aG docker <panel-user>   &&   restart the panel
#   2. let the panel use sudo for docker only (sudoers: rslmc ALL=(root) NOPASSWD: /usr/bin/docker)
#        RSLMC_DOCKER_SUDO=1
#   3. point the panel at the socket your own CLI uses (rootless Docker, Podman, a TCP proxy)
#        RSLMC_DOCKER_HOST=unix:///run/user/1000/docker.sock
#
# RSLMC_DOCKER_BIN=/usr/bin/docker   # use a specific CLI binary
# RSLMC_DOCKER_NETWORK=host          # container networking: host (default is bridge with -p)
